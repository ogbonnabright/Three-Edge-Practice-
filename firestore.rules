rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unlisted paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // STRICT ADMINISTRATOR AUTHORIZATION
    // Designated administrator accounts:
    // 1. chiaghalam@gmail.com
    // 2. admin@tep.com.ng
    // 3. registry@tep.com.ng
    // Other @tep.com.ng accounts do NOT automatically receive administrator privileges!
    // They must be explicitly authorized by an existing administrator via an active document in /admins/{uid}.
    function isDesignatedAdminEmail() {
      return request.auth.token.email != null && (
        request.auth.token.email == "chiaghalam@gmail.com" ||
        request.auth.token.email == "admin@tep.com.ng" ||
        request.auth.token.email == "registry@tep.com.ng"
      );
    }

    function isAdmin() {
      return isSignedIn() && isEmailVerified() && (
        isDesignatedAdminEmail() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Connection testing endpoint
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Users Collection: Only authorized administrators can create or delete user profile records.
    match /users/{userId} {
      allow get: if (isSignedIn() && isEmailVerified() && request.auth.uid == userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(userId);
      allow update: if ((isSignedIn() && isEmailVerified() && request.auth.uid == userId && isValidId(userId) && incoming().role == existing().role) || isAdmin());
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Authorization Registry: Explicit admin-controlled authorization mapping
    match /authorization_registry/{authId} {
      allow get: if isAdmin() || (
        isSignedIn() && isEmailVerified() && isValidId(authId) && (
          authId == request.auth.uid ||
          (resource != null && resource.data.status == 'Active' && resource.data.uid == request.auth.uid)
        )
      );
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin() && isValidId(authId);
    }

    // Admins Collection (Restricted: ordinary clients cannot read, create, or promote admin records)
    match /admins/{adminId} {
      allow get: if isSignedIn() && isEmailVerified() && isValidId(adminId) && (isAdmin() || adminId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isSignedIn() && isEmailVerified() && isValidId(adminId) && (
        isAdmin() || (isDesignatedAdminEmail() && adminId == request.auth.uid)
      );
      allow update: if isAdmin() && isValidId(adminId);
      allow delete: if isAdmin() && isValidId(adminId) && (
        adminId != request.auth.uid || !isDesignatedAdminEmail()
      );
    }

    // Clients Collection (Approved Client Registration Directory):
    // 1. Only authorized administrators can create, update, or delete client profiles.
    // 2. Approved clients can only read their own profile, and only if their status is Active.
    // 3. Deactivated clients are denied access.
    match /clients/{clientId} {
      allow get: if isSignedIn() && isEmailVerified() && isValidId(clientId) && (
        isAdmin() || (
          resource != null && resource.data.status == 'Active' && (
            resource.data.uid == request.auth.uid ||
            (request.auth.token.email != null && resource.data.email == request.auth.token.email)
          )
        )
      );
      allow list: if isSignedIn() && isEmailVerified() && (
        isAdmin() || (
          resource.data.status == 'Active' && (
            resource.data.uid == request.auth.uid ||
            (request.auth.token.email != null && resource.data.email == request.auth.token.email)
          )
        )
      );
      allow create: if isAdmin() && isValidId(clientId);
      allow update: if isAdmin() && isValidId(clientId);
      allow delete: if isAdmin() && isValidId(clientId);
    }

    // Legal Cases Collection:
    // 1. Only administrators can onboard (create) or delete legal cases.
    // 2. Active approved clients can read ONLY cases explicitly assigned to their UID or registered verified email.
    // 3. Deactivated clients lose access even if authenticated.
    // 4. Clients can update only their own case instructions/notes, but CANNOT modify ownership, clientAccess, or status.
    match /cases/{caseId} {
      allow get: if isSignedIn() && isEmailVerified() && isValidId(caseId) && (
        isAdmin() || (
          resource != null &&
          resource.data.clientAccess != 'Deactivated' && resource.data.clientAccess != 'Revoked' && (
            resource.data.clientUid == request.auth.uid ||
            (request.auth.token.email != null && resource.data.clientEmail == request.auth.token.email)
          )
        )
      );
      
      allow list: if isSignedIn() && isEmailVerified() && (
        isAdmin() || (
          resource.data.clientAccess != 'Deactivated' && resource.data.clientAccess != 'Revoked' && (
            resource.data.clientUid == request.auth.uid ||
            (request.auth.token.email != null && resource.data.clientEmail == request.auth.token.email)
          )
        )
      );
      
      allow create: if isAdmin() && isValidId(caseId);
      
      allow update: if isSignedIn() && isEmailVerified() && isValidId(caseId) && (
        isAdmin() || (
          ((resource.data.clientUid == request.auth.uid) || (request.auth.token.email != null && resource.data.clientEmail == request.auth.token.email)) &&
          resource.data.clientAccess != 'Deactivated' && resource.data.clientAccess != 'Revoked' &&
          incoming().clientUid == existing().clientUid &&
          incoming().clientEmail == existing().clientEmail &&
          incoming().clientAccess == existing().clientAccess &&
          incoming().caseNumber == existing().caseNumber &&
          incoming().status == existing().status
        )
      );
      
      allow delete: if isAdmin() && isValidId(caseId);
    }

    // Inquiries Collection:
    // 1. Legitimate contact inquiries can be submitted with validation.
    // 2. Only authorized administrators can read, list, update, or delete inquiries.
    match /inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId) && 
                       incoming().fullName is string && incoming().fullName.size() <= 200 &&
                       incoming().email is string && incoming().email.size() <= 200 &&
                       incoming().message is string && incoming().message.size() <= 10000;
      allow read, update, delete: if isAdmin() && isValidId(inquiryId);
    }
  }
}
