rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unlisted paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Strict Admin Email Definition:
    // STRICT RULE: Only chiaghalam@gmail.com, admin@tep.com.ng, registry@tep.com.ng, and verified @tep.com.ng accounts are associated to firm administration.
    function isAdminEmail() {
      return request.auth.token.email != null && (
        request.auth.token.email == "chiaghalam@gmail.com" ||
        request.auth.token.email == "admin@tep.com.ng" ||
        request.auth.token.email == "registry@tep.com.ng" ||
        request.auth.token.email.matches('^[a-zA-Z0-9._%+-]+@tep[.]com[.]ng$')
      );
    }

    // Admin authorization check:
    // STRICT RULE: Emails that are NOT associated to admin can NEVER be admin.
    // Non-admin emails are strictly forbidden from administrative access.
    function isAdmin() {
      return isSignedIn() && isAdminEmail();
    }

    // Connection testing endpoint
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Users Collection (PII Isolated strictly to the authenticated owner or admin)
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if (isOwner(userId) || isAdmin()) && isValidId(userId);
      allow delete: if false;
    }

    // Admins Collection (Strictly restricted: non-admin emails can NEVER create, update, or read other admin docs)
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (isAdmin() || adminId == request.auth.uid);
      allow list: if isAdmin();
      allow create, update: if isSignedIn() && isValidId(adminId) && isAdmin();
      allow delete: if isAdmin();
    }

    // Clients Collection (Client Profiles Directory):
    // 1. Only authorized Firm/Admin accounts (chiaghalam@gmail.com, admin@tep.com.ng, registry@tep.com.ng) can create, update, or delete clients.
    // 2. Client emails can only read their own profile, and only if their account status is Active.
    match /clients/{clientId} {
      allow get: if isSignedIn() && isValidId(clientId) && (
        isAdmin() || 
        (resource != null && request.auth.token.email != null && resource.data.email == request.auth.token.email && resource.data.status != 'Deactivated')
      );
      allow list: if isSignedIn() && (
        isAdmin() ||
        (request.auth.token.email != null && resource.data.email == request.auth.token.email && resource.data.status != 'Deactivated')
      );
      allow create: if isSignedIn() && isValidId(clientId) && isAdmin();
      allow update: if isSignedIn() && isValidId(clientId) && isAdmin();
      allow delete: if isSignedIn() && isValidId(clientId) && isAdmin();
    }

    // Legal Cases Collection:
    // STRICT ROLE-BASED ACCESS CONTROL:
    // 1. Firm emails (chiaghalam@gmail.com / admin@tep.com.ng / registry@tep.com.ng / @tep.com.ng) route to Admin with firmwide management access across all cases.
    // 2. Client emails registered during onboarding can access ONLY cases registered for their email or UID, provided clientAccess is not Deactivated.
    // 3. Emails NOT associated to admin can NEVER open admin management portal nor view other cases in the firm.
    // 4. Clients can NEVER create (onboard) or delete cases.
    match /cases/{caseId} {
      // Get single case:
      // Admins can read all cases across the firm.
      // Client emails can ONLY read the specific case registered for their email or UID (and not deactivated).
      allow get: if isSignedIn() && isValidId(caseId) && (
        isAdmin() || 
        (resource != null && (
          (request.auth.token.email != null && resource.data.clientEmail == request.auth.token.email && resource.data.clientAccess != 'Deactivated' && resource.data.clientAccess != 'Revoked') ||
          (resource.data.clientUid == request.auth.uid && resource.data.clientAccess != 'Deactivated' && resource.data.clientAccess != 'Revoked')
        ))
      );
      
      // List cases query:
      // Admins can query all cases across the firm.
      // Client emails can ONLY list cases registered for their verified email or UID (and not deactivated).
      // Unassociated or non-matching queries are strictly rejected with PERMISSION_DENIED.
      allow list: if isSignedIn() && (
        isAdmin() || 
        (request.auth.token.email != null && resource.data.clientEmail == request.auth.token.email && resource.data.clientAccess != 'Deactivated' && resource.data.clientAccess != 'Revoked') ||
        (resource.data.clientUid == request.auth.uid && resource.data.clientAccess != 'Deactivated' && resource.data.clientAccess != 'Revoked')
      );
      
      // Onboard (create) case: STRICTLY ADMIN ONLY
      allow create: if isSignedIn() && isValidId(caseId) && isAdmin();
      
      // Update case:
      // Admins have full update rights (manage docket info, updates, documents, notices).
      // Clients can only update notes/status on their own case, but cannot change ownership or clientAccess.
      allow update: if isSignedIn() && isValidId(caseId) && (
        isAdmin() || 
        (
          ((request.auth.token.email != null && resource.data.clientEmail == request.auth.token.email && resource.data.clientAccess != 'Deactivated' && resource.data.clientAccess != 'Revoked') || (resource.data.clientUid == request.auth.uid && resource.data.clientAccess != 'Deactivated' && resource.data.clientAccess != 'Revoked')) &&
          incoming().clientUid == existing().clientUid &&
          incoming().clientEmail == existing().clientEmail &&
          incoming().clientAccess == existing().clientAccess
        )
      );
      
      // Delete case: STRICTLY ADMIN ONLY
      allow delete: if isSignedIn() && isValidId(caseId) && isAdmin();
    }
  }
}
